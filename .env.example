# Copiar a .env y completar. Nunca commitear .env (RNF-02).
# El modo (DRY/LIVE) lo fija el script: pnpm dev o pnpm start.

# Remitentes autorizados: IDs de WhatsApp (LID) separados por comas (RF-22)
AUTHORIZED_SENDERS=

# Grupo de alertas a escuchar
WHATSAPP_GROUP_NAME=ALERTAS CRYPTO+

# Distancia máxima entre Entrada y SL, en % de la Entrada (RF-50). Por defecto 15.
MAX_SL_DISTANCE_PCT=15

# Anthropic: respaldo cuando el regex no saca todos los datos (RF-16).
# Vacía = sin respaldo: esas alertas se rechazan como incompletas.
ANTHROPIC_API_KEY=

# Binance (PRD-002): credenciales distintas por modo (RNF-07)
# BINANCE_DEMO_API_KEY=
# BINANCE_DEMO_API_SECRET=
# BINANCE_LIVE_API_KEY=
# BINANCE_LIVE_API_SECRET=
